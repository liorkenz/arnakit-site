# Shared secret checked on every request — only the Supabase Edge Functions should know this.
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-string

# From Apple Developer portal (see ../../docs/SETUP_ACCOUNTS.md, section 2)
APPLE_TEAM_ID=
WWDR_PEM_PATH=./certs/wwdr.pem
SIGNER_CERT_PATH=./certs/signerCert.pem
SIGNER_KEY_PATH=./certs/signerKey.pem
SIGNER_KEY_PASSPHRASE=

PORT=8787
